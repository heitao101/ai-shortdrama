# =============================================================================
# Clerk — copy to .env.local and fill in your keys
# Dashboard: https://dashboard.clerk.com → API Keys
# =============================================================================

# Required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth page paths (relative; next-intl adds /zh-HK, /en, etc.)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Redirect after auth (home with default locale)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# =============================================================================
# Stripe — copy keys from https://dashboard.stripe.com/apikeys
# Webhook secret: Stripe Dashboard → Developers → Webhooks (after creating endpoint)
# =============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# App URL for Stripe Checkout redirect (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Kling AI — official API (video generation)
# Create keys: https://app.klingai.com/global/dev → API Keys
# =============================================================================

KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# Optional: API region (default: Singapore)
# KLING_API_BASE_URL=https://api-singapore.klingai.com

# Optional: override models (SDK IDs, e.g. kling-v3.0-t2v / kling-v3.0-i2v)
# KLING_MODEL_T2V=kling-v2.6-t2v
# KLING_MODEL_I2V=kling-v2.6-i2v
