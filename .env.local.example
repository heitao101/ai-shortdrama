# =============================================================================
# Clerk — copy to .env.local and fill in your keys
# Dashboard: https://dashboard.clerk.com → API Keys
# =============================================================================

# Required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth page paths (relative; next-intl adds /zh-HK, /en, etc.)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Redirect after auth (home with default locale)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# =============================================================================
# Stripe — copy keys from https://dashboard.stripe.com/apikeys
# Webhook secret: Stripe Dashboard → Developers → Webhooks (after creating endpoint)
# =============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# App URL for Stripe Checkout redirect (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Vercel AI Gateway — video generation (Kling 3.0 / Seedance)
# Create key: https://vercel.com/dashboard → AI Gateway → API Keys
# =============================================================================

AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Optional: override default models (text-to-video / image-to-video)
# VIDEO_MODEL_T2V=klingai/kling-v3.0-t2v
# VIDEO_MODEL_I2V=klingai/kling-v3.0-i2v
